      "textReplacement" : {
        "lastSyncedAt" : "2026-09-10T16:27:31Z",
        "lastSyncedValue" : "Your ENTIRE response—including all code, inline comments, explanations, setup instructions, and usage examples—MUST be contained within a SINGLE markdown code block. Do NOT break the response into separate sections, distinct code blocks, or conversational text outside the block. \nPlace all narrative context, instructions, or documentation as code comments (e.g., `#` or `\/\/`) inside the single code block so the entire output can be copied and pasted at once without syntax errors.\n",
        "shortcut" : "xblock",
