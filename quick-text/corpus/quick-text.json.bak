    {
      "categoryId" : "image-quality",
      "createdAt" : "2026-08-14T17:51:40Z",
      "favorite" : false,
      "id" : "phrase-89BAE550-6738-427F-984A-08FDB0CAC5A6",
      "summary" : "",
      "tags" : [

      ],
      "textReplacement" : {
        "lastSyncedAt" : "2026-08-14T17:51:47Z",
        "lastSyncedValue" : "Using the attached image as a strict guide for composition, pattern, and texture, the directive is to deepen the overall luminance of the image. This change must be achieved strictly by shifting the value of each individual local color downward, rather than by applying a global dark overlay, a vignette, or a translucent veil. The specific color and value instructions include a local value remapping, where each distinct color swatch is shifted down by one to two value stops, or twenty to thirty percent luminance; this is to ensure that the lightest highlights become midtones and the midtones shift toward deep earth tones. Critically, there must be a zero overlay effect, meaning no flat dark tint, atmospheric haze, vignetting, or semi-transparent layer is to be applied over the top. The output should be a source-faithful version where every individual pigment is fundamentally darker.",
        "shortcut" : "xdarken",
        "syncEnabled" : true
      },
      "title" : "Color Value Stepdown",
      "updatedAt" : "2026-08-14T17:51:40Z",
      "value" : "Using the attached image as a strict guide for composition, pattern, and texture, the directive is to deepen the overall luminance of the image. This change must be achieved strictly by shifting the value of each individual local color downward, rather than by applying a global dark overlay, a vignette, or a translucent veil. The specific color and value instructions include a local value remapping, where each distinct color swatch is shifted down by one to two value stops, or twenty to thirty percent luminance; this is to ensure that the lightest highlights become midtones and the midtones shift toward deep earth tones. Critically, there must be a zero overlay effect, meaning no flat dark tint, atmospheric haze, vignetting, or semi-transparent layer is to be applied over the top. The output should be a source-faithful version where every individual pigment is fundamentally darker.",
      "visibility" : "private"
    },
