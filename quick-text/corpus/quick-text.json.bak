    {
      "categoryId" : "workflow-commands",
      "createdAt" : "2026-07-02T21:07:02Z",
      "favorite" : false,
      "id" : "workflow-commands-llmlearn",
      "tags" : [
        "llmlearn"
      ],
      "textReplacement" : {
        "lastSyncedAt" : "2026-07-29T04:22:15Z",
        "lastSyncedValue" : "Review this session and capture durable learnings worth preserving: user preferences, reusable instructions, architecture decisions, debugging insights, project knowledge, workflow improvements, documentation updates, tests, runbooks, or backlog items. Exclude temporary, speculative, redundant, or low-value details.",
        "shortcut" : "xlearn",
        "syncEnabled" : true
      },
      "title" : "Capture durable learnings",
      "updatedAt" : "2026-09-17T12:34:36Z",
      "value" : "Review this session for durable learnings.\n\nCapture:\n\nReusable rules, constraints, decisions, conventions, and preferences.\nFailure modes, debugging insights, and avoidable complexity.\nImplicit best practices and proactive default behaviors.\nPersistent project knowledge, workflow improvements, documentation, tests, runbooks, and backlog items.\n\nExclude temporary, speculative, redundant, or low-value details.\n\nRoute each learning to the right destination. Use project instructions only for durable guidance that should shape future agent behavior.\n\nPropose minimal exact changes: add, revise, consolidate, or remove. Avoid duplication, overfitting, and bloat.",
      "visibility" : "public"
    },
    {
      "categoryId" : "bullfinch",
