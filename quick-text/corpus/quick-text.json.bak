      "title" : "Bullfinch Watch Folder",
      "updatedAt" : "2026-07-02T22:14:10Z",
      "value" : "Add this material to the Bullfinch Watch Folder in Google Drive. Include a concise note explaining the relevant context, source, and intended follow-up.",
      "visibility" : "private"
    },
    {
      "categoryId" : "workflow-commands",
      "createdAt" : "2026-07-02T21:07:02Z",
      "favorite" : true,
      "id" : "workflow-commands-compush",
      "tags" : [
        "compush"
      ],
      "textReplacement" : {
        "lastSyncedAt" : "2026-08-31T11:59:40Z",
        "lastSyncedValue" : "Commit all outstanding changes. Validate, merge, and delete any existing non-main branches (local + remote), then push main. If no secondary branches exist, skip straight to pushing main.",
        "shortcut" : "xpush",
        "syncEnabled" : true
      },
      "title" : "Github: Commit, Push, Merge",
      "updatedAt" : "2026-08-31T11:54:25Z",
      "value" : "Commit all outstanding changes. Validate, merge, and delete any existing non-main branches (local + remote), then push main. If no secondary branches exist, skip straight to pushing main.",
      "visibility" : "public"
    },
    {
      "categoryId" : "image-quality",
